# Rename to .env and fill in any keys your solution needs.
# We have accounts with these providers and will supply real keys when reviewing.

ANTHROPIC_API_KEY=sk-ant-xxxxx
OPENAI_API_KEY=sk-xxxxx
ELEVEN_LABS_API_KEY=xxxxx
GOOGLE_CLOUD_API_KEY=xxxxx
AWS_ACCESS_KEY_ID=xxxxx
AWS_SECRET_ACCESS_KEY=xxxxx
AWS_REGION=us-west-2

# --- PACER REQUIRED (fill these in) ---
# All three are required. OpenAI/ElevenLabs/Google/AWS keys above are NOT used by Pacer.

# Anthropic — from console.anthropic.com or provided by Luma
# If absent or invalid, Pacer streams a deterministic fallback response instead of calling Claude.
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Supabase Postgres — DATABASE_URL is the transaction pooler (port 6543, ?pgbouncer=true)
# DIRECT_URL is the direct connection (port 5432) used by Prisma CLI migrations only
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# --- PACER OPTIONAL ---

# Anthropic model override (defaults to claude-sonnet-4-6 if unset)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Strava API — optional; app works from seeded data without Strava credentials
STRAVA_CLIENT_ID=xxxxx
STRAVA_CLIENT_SECRET=xxxxx
STRAVA_REDIRECT_URI=http://localhost:3000/api/auth/strava/callback

# Session encryption — generate with: openssl rand -hex 32
SESSION_SECRET=xxxxx

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
